// Schema Prisma — Central Cobertura de Provas
//
// DEV (local):  provider = "sqlite",  DATABASE_URL = "file:./dev.db"
// PROD (Supabase): trocar provider para "postgresql" e apontar a
//                  DATABASE_URL para a connection string do Supabase.
// Os modelos foram mantidos compatíveis com ambos (sem tipos exclusivos
// do Postgres): `estados` é uma string JSON, ids são cuid (String).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Contas de administrador (acesso à área /admin)
model User {
  id       String   @id @default(cuid())
  nome     String
  email    String   @unique
  senhaHash String
  role     String   @default("admin")
  criadoEm DateTime @default(now())
}

/// Uma seção/categoria do hub (gerenciada pelo admin)
model Secao {
  id           String   @id @default(cuid())
  titulo       String
  /// Emoji opcional exibido ao lado do título
  icone        String?
  /// "R1" (Acesso Direto) ou "R+" (Especialidade)
  nivel        String
  /// Tipo predominante (pré-seleciona o formulário de conteúdo)
  tipoPadrao   String   @default("youtube")
  /// "aberto" (público) ou "cadastro" (exige cadastro — exibida com blur + CTA)
  acesso       String   @default("aberto")
  /// Posição de exibição na home (menor = primeiro)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  conteudos Conteudo[]
}

/// Um conteúdo do hub (vídeo do YouTube ou arquivo para download)
model Conteudo {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String?
  /// Seção à qual o conteúdo pertence (coluna legada "blocoId")
  secaoId     String   @map("blocoId")
  secao       Secao    @relation(fields: [secaoId], references: [id])
  /// "R1" ou "R+" — derivado da seção no momento da gravação
  nivel       String
  /// "herdar" (segue a seção), "aberto" (sempre público) ou
  /// "cadastro" (travado mesmo em seção aberta)
  acesso      String   @default("herdar")
  /// "youtube" ou "arquivo"
  tipo        String
  url         String
  prova       String?
  /// Lista de UFs em JSON, ex.: ["SP","RJ"]. Vazio "[]" = nacional.
  estados     String   @default("[]")
  thumbnail   String?
  duracaoMin  Int?
  publicadoEm DateTime @default(now())
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([secaoId])
  @@index([nivel])
}

/// Lead capturado pela página de cadastro (visitante que destravou as seções)
model Lead {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String
  /// UFs das provas que vai prestar, em JSON: ["SP","RJ"] (formulário antigo)
  provas    String   @default("[]")
  /// Todas as respostas do formulário HubSpot, em JSON { campo: valor }
  respostas String   @default("{}")
  /// Quando o lead foi enviado com sucesso à HubSpot (null = pendente/reprocessar)
  hubspotEm DateTime?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  votos Voto[]
}

/// Uma prova para a qual o time monta previsões de temas (ex.: "USP-SP 2026").
model Prova {
  id       String  @id @default(cuid())
  nome     String
  /// UF da prova (opcional)
  estado   String?
  /// "R1" | "R+" | null
  nivel    String?
  /// "votacao" (aberta p/ votar) | "encerrada" (votação fechada, aguardando
  /// resultado) | "resultado" (gabarito lançado, pontuação disponível)
  status   String  @default("votacao")
  /// Data/hora da prova (para contagem regressiva), opcional
  dataProva DateTime?
  ordem    Int     @default(0)
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  previsoes Previsao[]

  @@index([status])
}

/// Um tema que o time acredita que pode cair na prova; usuários votam sim/não.
model Previsao {
  id            String  @id @default(cuid())
  provaId       String
  prova         Prova   @relation(fields: [provaId], references: [id], onDelete: Cascade)
  titulo        String
  descricao     String?
  especialidade String?
  /// Resultado após a prova: null = indefinido, true = caiu, false = não caiu
  caiu          Boolean?
  ordem         Int     @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  votos Voto[]

  @@index([provaId])
}

/// Voto de um lead numa previsão (true = vai cair, false = não vai cair).
model Voto {
  id         String   @id @default(cuid())
  previsaoId String
  previsao   Previsao @relation(fields: [previsaoId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  voto       Boolean
  criadoEm   DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([previsaoId, leadId])
  @@index([leadId])
}
