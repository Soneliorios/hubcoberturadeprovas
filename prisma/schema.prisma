// Schema Prisma — Central Cobertura de Provas
//
// DEV (local):  provider = "sqlite",  DATABASE_URL = "file:./dev.db"
// PROD (Supabase): trocar provider para "postgresql" e apontar a
//                  DATABASE_URL para a connection string do Supabase.
// Os modelos foram mantidos compatíveis com ambos (sem tipos exclusivos
// do Postgres): `estados` é uma string JSON, ids são cuid (String).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Contas de administrador (acesso à área /admin)
model User {
  id       String   @id @default(cuid())
  nome     String
  email    String   @unique
  senhaHash String
  role     String   @default("admin")
  criadoEm DateTime @default(now())
}

/// Uma seção/categoria do hub (gerenciada pelo admin)
model Secao {
  id           String   @id @default(cuid())
  titulo       String
  /// Emoji opcional exibido ao lado do título
  icone        String?
  /// "R1" (Acesso Direto) ou "R+" (Especialidade)
  nivel        String
  /// Tipo predominante (pré-seleciona o formulário de conteúdo)
  tipoPadrao   String   @default("youtube")
  /// "aberto" (público) ou "cadastro" (exige cadastro — exibida com blur + CTA)
  acesso       String   @default("aberto")
  /// Posição de exibição na home (menor = primeiro)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  conteudos Conteudo[]
}

/// Um conteúdo do hub (vídeo do YouTube ou arquivo para download)
model Conteudo {
  id          String   @id @default(cuid())
  titulo      String
  descricao   String?
  /// Seção à qual o conteúdo pertence (coluna legada "blocoId")
  secaoId     String   @map("blocoId")
  secao       Secao    @relation(fields: [secaoId], references: [id])
  /// "R1" ou "R+" — derivado da seção no momento da gravação
  nivel       String
  /// "youtube" ou "arquivo"
  tipo        String
  url         String
  prova       String?
  /// Lista de UFs em JSON, ex.: ["SP","RJ"]. Vazio "[]" = nacional.
  estados     String   @default("[]")
  thumbnail   String?
  duracaoMin  Int?
  publicadoEm DateTime @default(now())
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([secaoId])
  @@index([nivel])
}

/// Lead capturado pela página de cadastro (visitante que destravou as seções)
model Lead {
  id        String   @id @default(cuid())
  nome      String
  email     String   @unique
  telefone  String
  /// UFs das provas que vai prestar, em JSON: ["SP","RJ"]
  provas    String   @default("[]")
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
