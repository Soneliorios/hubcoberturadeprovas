# === Supabase Storage (upload de arquivos pelo admin) ===
# Settings > API: Project URL + service_role key (secreta!)
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# === Banco de dados (Supabase / Postgres) ===
# Pegue as strings no Supabase: botão "Connect" > ORMs > Prisma.
# ATENÇÃO: se a senha tiver caracteres especiais (@ $ / # etc.), faça URL-encode
# (ex.: $ -> %24, / -> %2F, # -> %23).
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# Para desenvolvimento local sem Supabase, use SQLite:
# 1) troque o provider para "sqlite" em prisma/schema.prisma
# 2) DATABASE_URL="file:./dev.db"  (e remova o directUrl do schema)

# === Auth.js (NextAuth) ===
# Gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-forte"
