# === HubSpot (formulário de cadastro + rastreamento) ===
HUBSPOT_PORTAL_ID="[PORTAL_ID]"
HUBSPOT_FORM_ID="[FORM_GUID]"
# Private App token com escopo "forms" (leitura da definição do formulário)
HUBSPOT_PRIVATE_APP_TOKEN="[PAT_TOKEN]"
# (Opcionais) Contexto da página enviado à HubSpot (hs_url/hs_url_domain).
# Normalmente a URL real é capturada do navegador. Use estes para FORÇAR
# um domínio canônico (ex.: workflow que filtra por domínio específico):
# HUBSPOT_PAGE_URL="https://seu-dominio.com.br/cadastro"
# HUBSPOT_PAGE_NAME="Central Cobertura de Provas — Cadastro"
# Base do site (usada como fallback da URL da página):
# NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# === Supabase Storage (upload de arquivos pelo admin) ===
# Settings > API: Project URL + service_role key (secreta!)
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"

# === IA (importar previsões do PDF do MedBrain) ===
# Chave da API do Google Gemini — grátis em aistudio.google.com (só conta Google,
# sem cartão). Usada só no admin, no servidor, para ler o PDF e extrair as
# previsões. Marque como "Sensitive" na Vercel.
GEMINI_API_KEY="AIza..."

# === Banco de dados (Supabase / Postgres) ===
# Pegue as strings no Supabase: botão "Connect" > ORMs > Prisma.
# ATENÇÃO: se a senha tiver caracteres especiais (@ $ / # etc.), faça URL-encode
# (ex.: $ -> %24, / -> %2F, # -> %23).
DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres"

# Para desenvolvimento local sem Supabase, use SQLite:
# 1) troque o provider para "sqlite" em prisma/schema.prisma
# 2) DATABASE_URL="file:./dev.db"  (e remova o directUrl do schema)

# === Auth.js (NextAuth) ===
# Gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-forte"
